# --- Database (PostgreSQL) ---
# 本番: Neon (https://neon.tech) / Supabase / Vercel Postgres など。Vercelデプロイ時は Vercel側の環境変数で設定。
# ローカル: docker run -d -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16  などで立ち上げ可。
# 例(Neon): postgresql://USER:PASS@xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daiyacosme?schema=public"

# --- Web Search Provider ---
# どのプロバイダを使うか: "mock" | "firecrawl" | "tavily" | "serpapi"
SEARCH_PROVIDER="mock"
FIRECRAWL_API_KEY=""
TAVILY_API_KEY=""
SERPAPI_API_KEY=""

# --- LLM Provider ---
# どのプロバイダを使うか: "mock" | "anthropic" | "openai"
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- App ---
NEXT_PUBLIC_APP_NAME="DaiyaCosme Research"
